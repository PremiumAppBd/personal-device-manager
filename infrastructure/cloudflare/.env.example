# Template for Cloudflare deployment variables. Copy and fill locally; never
# commit the filled file. Secrets go through `wrangler secret put`, NOT here.

# Non-secret vars (can also live in wrangler.toml [vars]):
ENVIRONMENT=production
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=your-access-application-aud-tag

# Dashboard build-time:
VITE_API_BASE_URL=https://pdm-api.your-subdomain.workers.dev
VITE_DEMO_MODE=false
