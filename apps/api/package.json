{
  "name": "@pdm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo \"(api) no linter configured\"",
    "db:migrate:local": "wrangler d1 migrations apply pdm_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pdm_db --remote",
    "seed:owner:local": "node scripts/seed-owner.mjs --local"
  },
  "dependencies": {
    "@pdm/shared": "workspace:*",
    "hono": "^4.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20250906.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "wrangler": "^4.0.0"
  }
}
