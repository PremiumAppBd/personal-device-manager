{
  "name": "personal-device-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Device Manager (PDM) - private, self-hosted, consent-based Android device management.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/* run build && pnpm -r --filter ./apps/* run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "dev:api": "pnpm --filter @pdm/api run dev",
    "dev:dashboard": "pnpm --filter @pdm/dashboard run dev",
    "db:migrate:local": "pnpm --filter @pdm/api run db:migrate:local"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "sharp", "@cloudflare/workerd-linux-64"]
  }
}
